# Backend Configuration (Supabase / Production Profile)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Supabase PostgreSQL (Used when SPRING_PROFILES_ACTIVE=supabase)
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Supabase Auth & Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-characters-long
SUPABASE_STORAGE_BUCKET=operational-media

# Firebase Cloud Messaging (HTTP v1 Live Push Delivery)
# Drop firebase-service-account.json into backend/ OR set FCM_CREDENTIALS_PATH / FCM_CREDENTIALS_JSON.
# When credentials are present, live FCM HTTP v1 push activates automatically alongside the in-app inbox.
FCM_ENABLED=true
FCM_PROJECT_ID=mandiri-transport-ops
FCM_CREDENTIALS_PATH=./firebase-service-account.json
FCM_CREDENTIALS_JSON=
FCM_API_BASE_URL=https://fcm.googleapis.com

# FlightAware Research Module & Token Encryption (AES-256-GCM)
# Keep FLIGHT_TRACKING_ENCRYPTION_KEY outside source control in production!
FLIGHT_TRACKING_ENCRYPTION_KEY=replace-with-32-byte-secret-encryption-key-in-production
FLIGHT_TRACKING_HTTP_TIMEOUT_MS=10000
FLIGHT_TRACKING_MIN_POLL_INTERVAL_SECONDS=15
FLIGHT_TRACKING_POLL_LOG_RETENTION_DAYS=30
FLIGHTAWARE_POLL_URL=https://www.flightaware.com/ajax/trackpoll.rvt


